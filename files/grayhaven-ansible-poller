#!/usr/bin/env bash
set -Eeuo pipefail

RUNNER_ENV="/etc/grayhaven/ansible/runner.env"
ANSIBLE_HOME="/home/ansible"
# Repository settings are populated by the required runner environment file.
REPO_URL=""
REPO_REF=""
CHECKOUT_DIR=""
VAULT_REPO_URL=""
VAULT_REPO_REF=""
VAULT_CHECKOUT_DIR=""
ANSIBLE_COLLECTIONS_PATH="${ANSIBLE_HOME}/.ansible/collections"
ANSIBLE_CONTROL_PRIVATE_KEY="${ANSIBLE_HOME}/.ssh/id_ed25519"
VAULT_DEPLOY_PRIVATE_KEY="${ANSIBLE_HOME}/.ssh/grayhaven_vault_deploy_key"
GITHUB_KNOWN_HOSTS="${ANSIBLE_HOME}/.ssh/github_known_hosts"
GITHUB_META_URL="https://api.github.com/meta"

log() {
  printf '[grayhaven-ansible-poller] %s\n' "$*"
}

drop_to_ansible() {
  if [[ "$(id -un)" == "ansible" ]]; then
    export HOME="$ANSIBLE_HOME"
    export USER="ansible"
    export LOGNAME="ansible"
    export ANSIBLE_COLLECTIONS_PATH
    export ANSIBLE_COLLECTIONS_PATHS="$ANSIBLE_COLLECTIONS_PATH"
    return
  fi

  exec runuser -u ansible -- env \
    HOME="$ANSIBLE_HOME" \
    USER="ansible" \
    LOGNAME="ansible" \
    ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
    ANSIBLE_COLLECTIONS_PATHS="$ANSIBLE_COLLECTIONS_PATH" \
    "$0" "$@"
}

require_file() {
  local path="$1"

  if [[ ! -f "$path" ]]; then
    log "Required file is missing: $path"
    exit 1
  fi
}

prepare_github_known_hosts() {
  local github_meta_json
  local github_known_hosts

  install -d -m 0700 "${ANSIBLE_HOME}/.ssh"

  github_meta_json="$(mktemp)"
  github_known_hosts="$(mktemp)"

  curl -fsSL \
    --retry 5 \
    --retry-all-errors \
    --retry-delay 3 \
    --retry-max-time 60 \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2026-03-10" \
    "$GITHUB_META_URL" > "$github_meta_json"

  /usr/bin/python3 - "$github_meta_json" > "$github_known_hosts" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as github_meta_file:
    github_meta = json.load(github_meta_file)

ssh_keys = github_meta.get("ssh_keys") or []
if not ssh_keys:
    raise SystemExit("GitHub meta response did not include ssh_keys.")

for ssh_key in ssh_keys:
    print(f"github.com {ssh_key}")
PY

  install -m 0644 "$github_known_hosts" "$GITHUB_KNOWN_HOSTS"
  rm -f "$github_meta_json" "$github_known_hosts"
}

remote_ref() {
  local repo_url="$1"
  local repo_ref="$2"
  local private_key="${3:-}"
  local git_ssh_command

  git_ssh_command="ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${GITHUB_KNOWN_HOSTS}"

  if [[ -n "$private_key" ]]; then
    git_ssh_command="ssh -i ${private_key} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${GITHUB_KNOWN_HOSTS}"
  fi

  GIT_SSH_COMMAND="$git_ssh_command" \
    git ls-remote "$repo_url" "refs/heads/${repo_ref}" "refs/tags/${repo_ref}" | awk 'NR == 1 { print $1 }'
}

checkout_head() {
  local checkout_dir="$1"

  # An absent checkout needs the runner to perform its initial clone. Restrict
  # discovery to this checkout so Git cannot inherit a parent repository.
  if [[ ! -e "${checkout_dir}/.git" ]]; then
    return 0
  fi

  git -C "$checkout_dir" rev-parse --verify HEAD
}

format_ref_for_log() {
  local value="$1"

  if [[ -z "$value" ]]; then
    printf '<none>'
    return
  fi

  printf '%s' "$value"
}

main() {
  drop_to_ansible "$@"

  require_file "$RUNNER_ENV"
  require_file "$ANSIBLE_CONTROL_PRIVATE_KEY"
  require_file "$VAULT_DEPLOY_PRIVATE_KEY"

  # shellcheck disable=SC1090
  source "$RUNNER_ENV"

  local setting
  for setting in REPO_URL REPO_REF CHECKOUT_DIR VAULT_REPO_URL VAULT_REPO_REF VAULT_CHECKOUT_DIR; do
    if [[ -z "${!setting:-}" ]]; then
      log "A required runner repository setting is missing."
      exit 1
    fi
  done

  prepare_github_known_hosts

  local config_ref
  local vault_ref
  local previous_config_ref
  local previous_vault_ref

  config_ref="$(remote_ref "$REPO_URL" "$REPO_REF")"
  vault_ref="$(remote_ref "$VAULT_REPO_URL" "$VAULT_REPO_REF" "$VAULT_DEPLOY_PRIVATE_KEY")"
  if [[ -z "$config_ref" || -z "$vault_ref" ]]; then
    log "Unable to resolve one or more tracked repository refs."
    exit 1
  fi

  previous_config_ref="$(checkout_head "$CHECKOUT_DIR")"
  previous_vault_ref="$(checkout_head "$VAULT_CHECKOUT_DIR")"

  if [[ "$config_ref" == "$previous_config_ref" && "$vault_ref" == "$previous_vault_ref" ]]; then
    log "No repository changes detected."
    exit 0
  fi

  log "Tracked config ref ${REPO_REF}: old=$(format_ref_for_log "$previous_config_ref") new=${config_ref}"
  log "Tracked vault ref ${VAULT_REPO_REF}: old=$(format_ref_for_log "$previous_vault_ref") new=${vault_ref}"
  if [[ "$config_ref" != "$previous_config_ref" ]]; then
    log "Config repository change detected for ${REPO_REF}."
  fi
  if [[ "$vault_ref" != "$previous_vault_ref" ]]; then
    log "Vault repository change detected for ${VAULT_REPO_REF}."
  fi
  log "Repository change detected; triggering Ansible runner."
  sudo -n systemctl start --no-block grayhaven-ansible-runner.service
}

if [[ "${GRAYHAVEN_UNIT_TEST_SOURCE_ONLY:-0}" != "1" ]]; then
  main "$@"
fi
