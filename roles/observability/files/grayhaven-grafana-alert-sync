class GrafanaError(RuntimeError):
    """Raised when the Grafana API returns an unrecoverable response."""


class GrafanaClient:
    def __init__(self, stack_url: str, api_token: str) -> None:
        self.stack_url = stack_url.rstrip("/")
        self.api_token = api_token

    def request(
        self,
        method: str,
        path: str,
        payload: dict[str, Any] | None = None,
        expected: tuple[int, ...] = (200,),
    ) -> Any:
        body = None
        headers = {
            "Accept": "application/json",
            "Authorization": f"Bearer {self.api_token}",
        }
        if payload is not None:
            body = json.dumps(payload).encode("utf-8")
            headers["Content-Type"] = "application/json"

        url = f"{self.stack_url}{path}"
        for attempt in range(5):
            request = urllib.request.Request(url, data=body, headers=headers, method=method)
            try:
                with urllib.request.urlopen(request, timeout=30) as response:
                    status = response.getcode()
                    response_body = response.read().decode("utf-8")
            except urllib.error.HTTPError as error:
                if error.code == 429 or 500 <= error.code <= 599:
                    retry_after = error.headers.get("Retry-After")
                    delay = int(retry_after) if retry_after and retry_after.isdigit() else min(2**attempt, 30)
                    time.sleep(delay)
                    continue

                message = error.read().decode("utf-8", errors="replace")
                raise GrafanaError(f"{method} {path} failed with HTTP {error.code}: {message}") from error

            if status not in expected:
                raise GrafanaError(f"{method} {path} returned unexpected HTTP status {status}")

            if not response_body:
                return None

            return json.loads(response_body)

        raise GrafanaError(f"{method} {path} exceeded retry budget")

    def datasource_uid(self, name: str) -> str:
        encoded_name = urllib.parse.quote(name, safe="")
        datasource = self.request("GET", f"/api/datasources/name/{encoded_name}")
        return datasource["uid"]

    def folder_uid(self, title: str) -> str:
        encoded_query = urllib.parse.urlencode({"query": title})
        folders = self.request("GET", f"/api/folders?{encoded_query}")
        for folder in folders:
            if folder.get("title") == title:
                return folder["uid"]

        raise GrafanaError(f"Grafana folder {title!r} was not found")

    def alert_rules(self) -> list[dict[str, Any]]:
        return self.request("GET", "/api/v1/provisioning/alert-rules")

    def rule_group(self, folder_uid: str, group: str) -> dict[str, Any]:
        encoded_folder_uid = urllib.parse.quote(folder_uid, safe="")
        encoded_group = urllib.parse.quote(group, safe="")
        return self.request(
            "GET",
            f"/api/v1/provisioning/folder/{encoded_folder_uid}/rule-groups/{encoded_group}",
        )

    def update_rule_group_interval(self, folder_uid: str, group: str, interval_seconds: int) -> bool:
        current = self.rule_group(folder_uid, group)
        if int(current.get("interval", 0)) == interval_seconds:
            return False

        current["interval"] = interval_seconds
        encoded_folder_uid = urllib.parse.quote(folder_uid, safe="")
        encoded_group = urllib.parse.quote(group, safe="")
        self.request(
            "PUT",
            f"/api/v1/provisioning/folder/{encoded_folder_uid}/rule-groups/{encoded_group}",
            current,
        )
        return True

    def create_rule(self, rule: dict[str, Any]) -> None:
        self.request("POST", "/api/v1/provisioning/alert-rules", rule, expected=(200, 201))

    def update_rule(self, uid: str, rule: dict[str, Any]) -> None:
        self.request("PUT", f"/api/v1/provisioning/alert-rules/{uid}", rule)

    def delete_rule(self, uid: str) -> None:
        self.request("DELETE", f"/api/v1/provisioning/alert-rules/{uid}", expected=(200, 202, 204))

    def create_silence(self, payload: dict[str, Any]) -> str:
        response = self.request(
            "POST",
            "/api/alertmanager/grafana/api/v2/silences",
            payload,
            expected=(200, 201, 202),
        )
        if not isinstance(response, dict):
            raise GrafanaError("Grafana silence create returned an unexpected response")

        silence_id = response.get("silenceID") or response.get("id")
        if not isinstance(silence_id, str) or not silence_id:
            raise GrafanaError("Grafana silence create did not return a silence ID")

        return silence_id


def valid_rule_uid(uid: str) -> bool:
    if re.fullmatch(r"gh-[0-9a-f]{24}", uid):
        return True
    try:
        parsed = uuid.UUID(uid)
    except ValueError:
        return False
    return parsed.version == 4 and str(parsed) == uid


def load_uid_registry(path: str) -> dict[str, str]:
    with open(path, encoding="utf-8") as registry_file:
        registry = json.load(registry_file)
    if not isinstance(registry, dict) or not registry:
        raise GrafanaError("Grafana alert UID registry must be a non-empty object")
    if not all(
        isinstance(identity, str)
        and identity
        and isinstance(uid, str)
        and valid_rule_uid(uid)
        for identity, uid in registry.items()
    ):
        raise GrafanaError("Grafana alert UID registry contains an invalid identity or UID")
    if len(set(registry.values())) != len(registry):
        raise GrafanaError("Grafana alert UID registry contains duplicate UIDs")
    return registry


def rule_uid(identity: str, registry: dict[str, str]) -> str:
    try:
        return registry[identity]
    except KeyError as error:
        raise GrafanaError(f"Grafana alert UID is not registered for {identity!r}") from error


def host_rule_identity(host: dict[str, Any], check: str) -> str:
    return f"host:{host['fqdn']}:{check}"


def domain_rule_identity(domain: str, check: str) -> str:
    return f"domain:{domain}:{check}"


def service_rule_identity(service: str, check: str) -> str:
    return f"service:{service}:{check}"


def promql_string(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def domain_regex(values: list[str]) -> str:
    return promql_string("|".join(re.escape(value) for value in values))


def duration_seconds(value: str | int) -> int:
    if isinstance(value, int):
        return value

    match = re.fullmatch(r"(\d+)([smhd])", value)
    if not match:
        raise GrafanaError(f"unsupported duration: {value!r}")

    amount = int(match.group(1))
    unit = match.group(2)
    multipliers = {
        "s": 1,
        "m": 60,
        "h": 3600,
        "d": 86400,
    }
    return amount * multipliers[unit]


def integer_at_least_threshold(value: object) -> int:
    """Translate a non-negative integer `>= value` into strict `gt` semantics."""

    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise GrafanaError("usage threshold must be a non-negative integer")
    return value - 1


def query_data(ref_id: str, datasource_uid: str, expression: str) -> dict[str, Any]:
    return {
        "refId": ref_id,
        "queryType": "",
        "relativeTimeRange": {"from": 600, "to": 0},
        "datasourceUid": datasource_uid,
        "model": {
            "datasource": {"type": "prometheus", "uid": datasource_uid},
            "editorMode": "code",
            "expr": expression,
            "instant": True,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": False,
            "refId": ref_id,
        },
    }


def threshold_data(evaluator_type: str, threshold: float) -> dict[str, Any]:
    return {
        "refId": "C",
        "queryType": "",
        "relativeTimeRange": {"from": 0, "to": 0},
        "datasourceUid": "__expr__",
        "model": {
            "conditions": [
                {
                    "evaluator": {"params": [threshold], "type": evaluator_type},
                    "operator": {"type": "and"},
                    "query": {"params": ["C"]},
                    "reducer": {"params": [], "type": "last"},
                    "type": "query",
                }
            ],
            "datasource": {"type": "__expr__", "uid": "__expr__"},
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold",
        },
    }


def alert_rule(
    *,
    identity: str,
    uid_registry: dict[str, str],
    title: str,
    folder_uid: str,
    rule_group: str,
    datasource_uid: str,
    expression: str,
    evaluator_type: str,
    threshold: float,
    labels: dict[str, str],
    annotations: dict[str, str],
    contact_point: str,
    duration: str = "5m",
    no_data_state: str = "OK",
) -> dict[str, Any]:
    return {
        "_identity": identity,
        "uid": rule_uid(identity, uid_registry),
        "title": title,
        "folderUID": folder_uid,
        "ruleGroup": rule_group,
        "condition": "C",
        "data": [
            query_data("A", datasource_uid, expression),
            threshold_data(evaluator_type, threshold),
        ],
        "noDataState": no_data_state,
        "execErrState": "Error",
        "for": duration if duration_seconds(duration) >= 300 else "5m",
        "annotations": annotations,
        "labels": {**labels, MANAGED_LABEL: MANAGED_VALUE},
        "isPaused": False,
        "notification_settings": {"receiver": contact_point},
    }


def base_labels(config: dict[str, Any], extra: dict[str, str]) -> dict[str, str]:
    labels = {
        "client": config["labels"]["client"],
        "environment": config["labels"]["environment"],
    }
    labels.update(extra)
    return labels


def host_labels(config: dict[str, Any], host: dict[str, Any], check: str) -> dict[str, str]:
    return base_labels(
        config,
        {
            "check": check,
            "host": host["fqdn"],
            "project": host["project"],
            "role": host["role"],
        },
    )


def host_selector(host: str) -> str:
    return f'host="{promql_string(host)}"'


def runner_state_queries(config: dict[str, Any]) -> tuple[str | None, str, int]:
    control_hosts = sorted({host["fqdn"] for host in config["hosts"] if host.get("control_node")})
    if not control_hosts:
        return None, "vector(0)", 1

    selector = (
        "node_systemd_unit_state{"
        f'host=~"{domain_regex(control_hosts)}",'
        'name="grayhaven-ansible-runner.service",state=~"active|activating"}'
    )
    # Both state series must be fresh before a previous active sample can suppress CPU.
    fresh = f"(count by (host) (count by (host, state) (last_over_time({selector}[2m]))) == 2)"
    reporting = f"(count({fresh}) or vector(0))"
    # Include the one-minute scrape interval in the 15-minute settling period.
    recent = f"(max by (host) (max_over_time({selector}[16m])) > 0)"
    suppress = (
        f"(max({recent} and on (host) {fresh}) "
        f"and on () ({reporting} == {len(control_hosts)}))"
    )
    return suppress, reporting, len(control_hosts)


def runner_state_metric_rule(config: dict[str, Any], folder_uid: str, datasource_uid: str) -> dict[str, Any]:
    _, reporting, expected = runner_state_queries(config)
    return alert_rule(
        identity=service_rule_identity("Ansible", "ansible_runner_state_metric"),
        uid_registry=config["uid_registry"],
        title="Ansible runner state metric",
        folder_uid=folder_uid,
        rule_group=config["grafana"]["evaluation_group"],
        datasource_uid=datasource_uid,
        expression=reporting,
        evaluator_type="lt",
        threshold=expected,
        duration="5m",
        no_data_state="Alerting",
        labels=base_labels(config, {"check": "ansible_runner_state_metric", "role": "bastion", "service": "Ansible"}),
        annotations={
            "summary": "Ansible runner state metric is missing",
            "description": "The control bastion's Ansible runner state metric is not reporting.",
        },
        contact_point=config["grafana"]["contact_point"],
    )


def service_rules(config: dict[str, Any], folder_uid: str, datasource_uid: str) -> list[dict[str, Any]]:
    rules = []
    service_config = config["service_units"]
    for host in config["hosts"]:
        units = list(service_config["common"])
        units.extend(service_config.get(host["role"], []))
        if host.get("control_node"):
            units.extend(service_config["control_node"])

        for unit in units:
            title = f"{host['short_hostname']} {unit['summary'].replace(' is down', '')}"
            expression = (
                "max by (host, environment, role, project, client) "
                f'(node_systemd_unit_state{{{host_selector(host["fqdn"])},'
                f'name="{promql_string(unit["name"])}",state="active"}})'
            )
            rules.append(
                alert_rule(
                    identity=host_rule_identity(host, unit["check"]),
                    uid_registry=config["uid_registry"],
                    title=title,
                    folder_uid=folder_uid,
                    rule_group=config["grafana"]["evaluation_group"],
                    datasource_uid=datasource_uid,
                    expression=expression,
                    evaluator_type="lt",
                    threshold=1,
                    labels=host_labels(config, host, unit["check"]),
                    annotations={
                        "summary": unit["summary"],
                        "description": f"{host['fqdn']} {unit['name']} is not active.",
                    },
                    contact_point=config["grafana"]["contact_point"],
                )
            )

    return rules


def host_metric_rules(config: dict[str, Any], folder_uid: str, datasource_uid: str) -> list[dict[str, Any]]:
    rules = []
    thresholds = config["thresholds"]
    runner_suppression, _, _ = runner_state_queries(config)
    for host in config["hosts"]:
        common = {
            "uid_registry": config["uid_registry"],
            "folder_uid": folder_uid,
            "rule_group": config["grafana"]["evaluation_group"],
            "datasource_uid": datasource_uid,
            "contact_point": config["grafana"]["contact_point"],
        }

        rules.append(
            alert_rule(
                identity=host_rule_identity(host, "metrics_data"),
                title=f"{host['short_hostname']} metrics data",
                expression=(
                    "max by (host, environment, role, project, client) "
                    f'(up{{{host_selector(host["fqdn"])},job="integrations/unix"}})'
                ),
                evaluator_type="lt",
                threshold=1,
                duration="5m",
                no_data_state="Alerting",
                labels=host_labels(config, host, "metrics_data"),
                annotations={
                    "summary": "Metrics data is missing",
                    "description": f"{host['fqdn']} is not sending Grafana Cloud metrics.",
                },
                **common,
            )
        )

        application_site = next(
            (site for site in config["sites"]
             if site.get("kind") == "application"
             and site.get("role", "web") == host["role"]),
            None,
        )
        if application_site is not None:
            application_name = application_site.get("display_name", "Time Tracker")
            health_check = application_site.get("health_check", "timetracker_health")
            rules.append(
                alert_rule(
                    identity=host_rule_identity(host, health_check),
                    title=f"{host['short_hostname']} {application_name} health check",
                    expression=(
                        "max by (host, domain, environment, role, project, client) "
                        f'(probe_success{{{host_selector(host["fqdn"])},'
                        f'domain="{promql_string(application_site["domain"])}",'
                        f'check="{promql_string(health_check)}"}})'
                    ),
                    evaluator_type="lt",
                    threshold=1,
                    duration="5m",
                    labels=base_labels(
                        config,
                        {
                            "check": health_check,
                            "domain": application_site["domain"],
                            "host": host["fqdn"],
                            "project": host["project"],
                            "role": host["role"],
                        },
                    ),
                    annotations={
                        "summary": f"{application_name} health check failed",
                        "description": (
                            f"{host['fqdn']} {application_name} local health endpoint "
                            "has not returned 200 OK for at least five minutes."
                        ),
                    },
                    **common,
                )
            )

        cpu_minutes = 5
        cpu_expression = (
            "100 * (1 - avg by (host, environment, role, project, client) "
            f'(rate(node_cpu_seconds_total{{{host_selector(host["fqdn"])},mode="idle"}}[{cpu_minutes}m])))'
        )
        if runner_suppression:
            cpu_expression = f"{cpu_expression} unless on () {runner_suppression}"
        rules.append(
            alert_rule(
                identity=host_rule_identity(host, "cpu_utilization"),
                title=f"{host['short_hostname']} CPU utilization",
                expression=cpu_expression,
                evaluator_type="gte",
                threshold=float(thresholds["cpu_percent"]),
                duration="5m",
                labels=host_labels(config, host, "cpu_utilization"),
                annotations={
                    "summary": "CPU utilization is high",
                    "description": (
                        f"{host['fqdn']} {cpu_minutes}-minute average CPU utilization is >= "
                        f"{thresholds['cpu_percent']}% for >= 5 minutes."
                    ),
                    "check_value": "{{ humanize $values.A.Value }}%",
                },
                **common,
            )
        )

        rules.append(
            alert_rule(
                identity=host_rule_identity(host, "memory_utilization"),
                title=f"{host['short_hostname']} memory utilization",
                expression=(
                    "100 * (1 - max by (host, environment, role, project, client) "
                    f'(node_memory_MemAvailable_bytes{{{host_selector(host["fqdn"])}}}) '
                    "/ max by (host, environment, role, project, client) "
                    f'(node_memory_MemTotal_bytes{{{host_selector(host["fqdn"])}}}))'
                ),
                evaluator_type="gte",
                threshold=float(thresholds["memory_percent"]),
                duration="2m",
                labels=host_labels(config, host, "memory_utilization"),
                annotations={
                    "summary": "Memory utilization is high",
                    "description": (
                        f"{host['fqdn']} memory utilization is >= {thresholds['memory_percent']}% "
                        "for >= 5 minutes."
                    ),
                    "check_value": "{{ humanize $values.A.Value }}%",
                },
                **common,
            )
        )

        rules.append(
            alert_rule(
                identity=host_rule_identity(host, "filesystem_space"),
                title=f"{host['short_hostname']} filesystem space utilization",
                expression=(
                    "100 * (1 - max by (host, environment, role, project, client, mountpoint) "
                    f'(node_filesystem_avail_bytes{{{host_selector(host["fqdn"])},mountpoint="/",'
                    'fstype!~"tmpfs|overlay"}) / max by (host, environment, role, project, client, mountpoint) '
                    f'(node_filesystem_size_bytes{{{host_selector(host["fqdn"])},mountpoint="/",'
                    'fstype!~"tmpfs|overlay"}))'
                ),
                evaluator_type="gte",
                threshold=float(thresholds["filesystem_percent"]),
                labels=host_labels(config, host, "filesystem_space"),
                annotations={
                    "summary": "Filesystem space utilization is high",
                    "description": (
                        f"{host['fqdn']} filesystem / space utilization is >= "
                        f"{thresholds['filesystem_percent']}%."
                    ),
                    "check_value": "{{ humanize $values.A.Value }}%",
                    "mount_point": "/",
                },
                **common,
            )
        )

        rules.append(
            alert_rule(
                identity=host_rule_identity(host, "filesystem_inode"),
                title=f"{host['short_hostname']} filesystem inode utilization",
                expression=(
                    "100 * (1 - max by (host, environment, role, project, client, mountpoint) "
                    f'(node_filesystem_files_free{{{host_selector(host["fqdn"])},mountpoint="/",'
                    'fstype!~"tmpfs|overlay"}) / max by (host, environment, role, project, client, mountpoint) '
                    f'(node_filesystem_files{{{host_selector(host["fqdn"])},mountpoint="/",'
                    'fstype!~"tmpfs|overlay"}))'
                ),
                evaluator_type="gte",
                threshold=float(thresholds["filesystem_inode_percent"]),
                labels=host_labels(config, host, "filesystem_inode"),
                annotations={
                    "summary": "Filesystem inode utilization is high",
                    "description": (
                        f"{host['fqdn']} filesystem / inode utilization is >= "
                        f"{thresholds['filesystem_inode_percent']}%."
                    ),
                    "check_value": "{{ printf \"%.3f\" $values.A.Value }}%",
                    "mount_point": "/",
                },
                **common,
            )
        )

        rules.append(
            alert_rule(
                identity=host_rule_identity(host, "swap_utilization"),
                title=f"{host['short_hostname']} swap utilization",
                expression=(
                    "100 * (1 - max by (host, environment, role, project, client) "
                    f'(node_memory_SwapFree_bytes{{{host_selector(host["fqdn"])}}}) '
                    "/ max by (host, environment, role, project, client) "
                    f'(node_memory_SwapTotal_bytes{{{host_selector(host["fqdn"])}}}))'
                ),
                evaluator_type="gte",
                threshold=float(thresholds["swap_percent"]),
                duration="2m",
                labels=host_labels(config, host, "swap_utilization"),
                annotations={
                    "summary": "Swap utilization is high",
                    "description": f"{host['fqdn']} swap utilization is >= {thresholds['swap_percent']}%.",
                    "check_value": "{{ humanize $values.A.Value }}%",
                },
                **common,
            )
        )

        rules.append(
            alert_rule(
                identity=host_rule_identity(host, "restic_stale_backup"),
                title=f"{host['short_hostname']} restic backup stale",
                expression=(
                    "time() - max by (host, environment, role, project, client) "
                    f'(grayhaven_restic_backup_last_success_timestamp_seconds{{{host_selector(host["fqdn"])}}})'
                ),
                evaluator_type="gt",
                threshold=float(thresholds["restic_stale_seconds"]),
                labels=host_labels(config, host, "restic_stale_backup"),
                annotations={
                    "summary": "Restic backup is stale",
                    "description": (
                        f"{host['fqdn']} restic backup has not completed successfully "
                        "within the expected window."
                    ),
                },
                **common,
            )
        )

        if host.get("control_node"):
            rules.append(
                alert_rule(
                    identity=host_rule_identity(host, "ansible_convergence"),
                    title=f"{host['short_hostname']} Ansible convergence",
                    expression=(
                        "max by (host, environment) "
                        f'(grayhaven_ansible_convergence_last_success{{{host_selector(host["fqdn"])}}})'
                    ),
                    evaluator_type="lt",
                    threshold=1,
                    labels=host_labels(config, host, "ansible_convergence"),
                    annotations={
                        "summary": "Last Ansible convergence failed",
                        "description": f"{host['fqdn']} last Ansible convergence did not complete successfully.",
                    },
                    **common,
                )
            )

    return rules


def site_rules(config: dict[str, Any], folder_uid: str, datasource_uid: str) -> list[dict[str, Any]]:
    rules = []
    if not config["sites"]:
        return rules

    common = {
        "uid_registry": config["uid_registry"],
        "folder_uid": folder_uid,
        "rule_group": config["grafana"]["evaluation_group"],
        "datasource_uid": datasource_uid,
        "contact_point": config["grafana"]["contact_point"],
    }

    for site in config["sites"]:
        site_host = next((host for host in config["hosts"] if host["role"] == site.get("role", "web")), None)
        if site_host is None:
            continue
        for target_domain in [site["domain"], *site["aliases"]]:
            rules.append(
                alert_rule(
                    identity=domain_rule_identity(target_domain, "https_200"),
                    title=f"{target_domain} HTTPS availability",
                    expression=(
                        "max by (domain, environment, role, project, client) "
                        f'(probe_success{{domain="{promql_string(target_domain)}",check="https_200"}})'
                    ),
                    evaluator_type="lt",
                    threshold=1,
                    duration="1m",
                    labels=base_labels(
                        config,
                        {
                            "check": "https_200",
                            "domain": target_domain,
                            "project": site_host["project"],
                            "role": site_host["role"],
                        },
                    ),
                    annotations={
                        "summary": "HTTPS/TLS availability check failed",
                        "description": (
                            f"{target_domain} could not establish an HTTPS/TLS connection."
                        ),
                    },
                    **common,
                )
            )

        if site.get("dev_domain"):
            rules.append(
                alert_rule(
                    identity=domain_rule_identity(site["dev_domain"], "dev_basic_auth_401"),
                    title=f"{site['dev_domain']} basic auth",
                    expression=(
                        "max by (domain, environment, role, project, client) "
                        f'(probe_success{{domain="{promql_string(site["dev_domain"])}",'
                        'check="dev_basic_auth_401"})'
                    ),
                    evaluator_type="lt",
                    threshold=1,
                    duration="1m",
                    labels=base_labels(
                        config,
                        {
                            "check": "dev_basic_auth_401",
                            "domain": site["dev_domain"],
                            "project": site_host["project"],
                            "role": site_host["role"],
                        },
                    ),
                    annotations={
                        "summary": "Development basic auth check failed",
                        "description": (
                            f"{site['dev_domain']} did not return 401 Unauthorized "
                            "without credentials."
                        ),
                    },
                    **common,
                )
            )

        if site.get("redirect_http", True):
            redirect_domains = [site["domain"], *site["aliases"]]
            if site.get("dev_domain"):
                redirect_domains.append(site["dev_domain"])
            rules.append(
                alert_rule(
                    identity=domain_rule_identity(site["domain"], "http_https_redirect"),
                    title=f"{site['domain']} HTTP to HTTPS redirects",
                    expression=(
                        "min by (domain, environment, role, project, client) "
                        f'(probe_success{{domain=~"{domain_regex(redirect_domains)}",'
                        'check="http_https_redirect"})'
                    ),
                    evaluator_type="lt",
                    threshold=1,
                    duration="1m",
                    labels=base_labels(
                        config,
                        {
                            "check": "http_https_redirect",
                            "domain": site["domain"],
                            "project": site_host["project"],
                            "role": site_host["role"],
                        },
                    ),
                    annotations={
                        "summary": "HTTP to HTTPS redirect check failed",
                        "description": (
                            f"{site['domain']} HTTP to HTTPS redirect checks did not all return "
                            "a valid HTTPS redirect."
                        ),
                    },
                    **common,
                )
            )

        if config.get("tls_mode") == "host" or site.get("role") == "mcp":
            rules.append(
                alert_rule(
                    identity=domain_rule_identity(site["domain"], "ssl_certificate_expired"),
                    title=f"{site['domain']} SSL certificate expired",
                    expression=(
                        "max by (domain, environment, role, project, client) "
                        f'(probe_ssl_earliest_cert_expiry{{domain="{promql_string(site["domain"])}",'
                        'check="ssl_certificate"} - time())'
                    ),
                    evaluator_type="lte",
                    threshold=0,
                    labels=base_labels(
                        config,
                        {
                            "check": "ssl_certificate_expired",
                            "domain": site["domain"],
                            "project": site_host["project"],
                            "role": site_host["role"],
                        },
                    ),
                    annotations={
                        "summary": "SSL certificate is expired",
                        "description": f"{site['domain']} SSL certificate is expired.",
                    },
                    **common,
                )
            )
            rules.append(
                alert_rule(
                    identity=domain_rule_identity(site["domain"], "ssl_certificate_expiring"),
                    title=f"{site['domain']} SSL certificate expiring within 14 days",
                    expression=(
                        "max by (domain, environment, role, project, client) "
                        "("
                        f'(probe_ssl_earliest_cert_expiry{{domain="{promql_string(site["domain"])}",'
                        'check="ssl_certificate"} - time() '
                        f'< {float(config["thresholds"]["certificate_expiring_seconds"])}) '
                        "and "
                        f'(probe_ssl_earliest_cert_expiry{{domain="{promql_string(site["domain"])}",'
                        'check="ssl_certificate"} - time() > 0)'
                        ")"
                    ),
                    evaluator_type="gt",
                    threshold=0,
                    labels=base_labels(
                        config,
                        {
                            "check": "ssl_certificate_expiring",
                            "domain": site["domain"],
                            "project": site_host["project"],
                            "role": site_host["role"],
                        },
                    ),
                    annotations={
                        "summary": "SSL certificate is expiring soon",
                        "description": f"{site['domain']} SSL certificate expires within 14 days.",
                        "check_value": "{{ humanizeDuration $values.A.Value }}",
                    },
                    **common,
                )
            )
            rules.append(
                alert_rule(
                    identity=domain_rule_identity(site["domain"], "ssl_certificate_trusted"),
                    title=f"{site['domain']} using untrusted SSL certificate",
                    expression=(
                        "max by (domain, environment, role, project, client) "
                        f'(probe_success{{domain="{promql_string(site["domain"])}",'
                        'check="ssl_certificate_trusted"})'
                    ),
                    evaluator_type="lt",
                    threshold=1,
                    duration="1m",
                    labels=base_labels(
                        config,
                        {
                            "check": "ssl_certificate_trusted",
                            "domain": site["domain"],
                            "project": site_host["project"],
                            "role": site_host["role"],
                        },
                    ),
                    annotations={
                        "summary": "SSL certificate is not publicly trusted",
                        "description": (
                            f"{site['domain']} is presenting an SSL certificate "
                            "that the external probe does not trust."
                        ),
                    },
                    **common,
                )
            )

    return rules


