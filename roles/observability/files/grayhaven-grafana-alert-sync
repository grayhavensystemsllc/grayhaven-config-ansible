#!/usr/bin/env python3
"""Synchronize Grayhaven-managed Grafana Cloud alert rules."""

from __future__ import annotations

import argparse
import base64
import copy
import hashlib
from datetime import datetime, timedelta, timezone
import json
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from typing import Any

from jinja2 import StrictUndefined, TemplateError
from jinja2.sandbox import SandboxedEnvironment
import yaml

MANAGED_LABEL = "configured_by"
MANAGED_VALUE = "ansible"
INITIAL_SILENCE_CREATED_BY = "grayhaven-grafana-alert-sync"
INITIAL_SILENCE_COMMENT = (
    "Initial Grayhaven Systems LLC convergence silence while new hosts "
    "settle and Alloy sends initial telemetry."
)


class GrafanaError(RuntimeError):
    """Raised when the Grafana API returns an unrecoverable response."""


class GrafanaClient:
    def __init__(self, stack_url: str, api_token: str) -> None:
        self.stack_url = stack_url.rstrip("/")
        self.api_token = api_token

    def request(
        self,
        method: str,
        path: str,
        payload: dict[str, Any] | None = None,
        expected: tuple[int, ...] = (200,),
    ) -> Any:
        body = None
        headers = {
            "Accept": "application/json",
            "Authorization": f"Bearer {self.api_token}",
        }
        if payload is not None:
            body = json.dumps(payload).encode("utf-8")
            headers["Content-Type"] = "application/json"

        url = f"{self.stack_url}{path}"
        for attempt in range(5):
            request = urllib.request.Request(url, data=body, headers=headers, method=method)
            try:
                with urllib.request.urlopen(request, timeout=30) as response:
                    status = response.getcode()
                    response_body = response.read().decode("utf-8")
            except urllib.error.HTTPError as error:
                if error.code == 429 or 500 <= error.code <= 599:
                    retry_after = error.headers.get("Retry-After")
                    delay = int(retry_after) if retry_after and retry_after.isdigit() else min(2**attempt, 30)
                    time.sleep(delay)
                    continue

                raise GrafanaError(f"{method} {path} failed with HTTP {error.code}") from error

            if status not in expected:
                raise GrafanaError(f"{method} {path} returned unexpected HTTP status {status}")

            if not response_body:
                return None

            return json.loads(response_body)

        raise GrafanaError(f"{method} {path} exceeded retry budget")

    def datasource_uid(self, name: str) -> str:
        encoded_name = urllib.parse.quote(name, safe="")
        datasource = self.request("GET", f"/api/datasources/name/{encoded_name}")
        return datasource["uid"]

    def folder_uid(self, title: str) -> str:
        encoded_query = urllib.parse.urlencode({"query": title})
        folders = self.request("GET", f"/api/folders?{encoded_query}")
        for folder in folders:
            if folder.get("title") == title:
                return folder["uid"]

        raise GrafanaError(f"Grafana folder {title!r} was not found")

    def alert_rules(self) -> list[dict[str, Any]]:
        return self.request("GET", "/api/v1/provisioning/alert-rules")

    def rule_group(self, folder_uid: str, group: str) -> dict[str, Any]:
        encoded_folder_uid = urllib.parse.quote(folder_uid, safe="")
        encoded_group = urllib.parse.quote(group, safe="")
        return self.request(
            "GET",
            f"/api/v1/provisioning/folder/{encoded_folder_uid}/rule-groups/{encoded_group}",
        )

    def update_rule_group_interval(self, folder_uid: str, group: str, interval_seconds: int) -> bool:
        current = self.rule_group(folder_uid, group)
        if int(current.get("interval", 0)) == interval_seconds:
            return False

        current["interval"] = interval_seconds
        encoded_folder_uid = urllib.parse.quote(folder_uid, safe="")
        encoded_group = urllib.parse.quote(group, safe="")
        self.request(
            "PUT",
            f"/api/v1/provisioning/folder/{encoded_folder_uid}/rule-groups/{encoded_group}",
            current,
        )
        return True

    def create_rule(self, rule: dict[str, Any]) -> None:
        self.request("POST", "/api/v1/provisioning/alert-rules", rule, expected=(200, 201))

    def update_rule(self, uid: str, rule: dict[str, Any]) -> None:
        self.request("PUT", f"/api/v1/provisioning/alert-rules/{uid}", rule)

    def delete_rule(self, uid: str) -> None:
        self.request("DELETE", f"/api/v1/provisioning/alert-rules/{uid}", expected=(200, 202, 204))

    def create_silence(self, payload: dict[str, Any]) -> str:
        response = self.request(
            "POST",
            "/api/alertmanager/grafana/api/v2/silences",
            payload,
            expected=(200, 201, 202),
        )
        if not isinstance(response, dict):
            raise GrafanaError("Grafana silence create returned an unexpected response")

        silence_id = response.get("silenceID") or response.get("id")
        if not isinstance(silence_id, str) or not silence_id:
            raise GrafanaError("Grafana silence create did not return a silence ID")

        return silence_id


def valid_rule_uid(uid: str) -> bool:
    if re.fullmatch(r"gh-[0-9a-f]{24}", uid):
        return True
    try:
        parsed = uuid.UUID(uid)
    except ValueError:
        return False
    return parsed.version == 4 and str(parsed) == uid


def load_uid_registry(path: str) -> dict[str, str]:
    with open(path, encoding="utf-8") as registry_file:
        registry = json.load(registry_file)
    if not isinstance(registry, dict):
        raise GrafanaError("Grafana alert UID registry must be an object")
    if not all(
        isinstance(identity, str)
        and identity
        and isinstance(uid, str)
        and valid_rule_uid(uid)
        for identity, uid in registry.items()
    ):
        raise GrafanaError("Grafana alert UID registry contains an invalid identity or UID")
    if len(set(registry.values())) != len(registry):
        raise GrafanaError("Grafana alert UID registry contains duplicate UIDs")
    return registry


def rule_uid(identity: str, registry: dict[str, str]) -> str:
    if not isinstance(identity, str) or not identity.strip():
        raise GrafanaError("Grafana alert identity must be a non-empty string")
    return registry.get(identity, "gh-" + hashlib.sha256(identity.encode()).hexdigest()[:24])


def host_rule_identity(host: dict[str, Any], check: str) -> str:
    return f"host:{host['fqdn']}:{check}"


def domain_rule_identity(domain: str, check: str) -> str:
    return f"domain:{domain}:{check}"


def service_rule_identity(service: str, check: str) -> str:
    return f"service:{service}:{check}"


def promql_string(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def domain_regex(values: list[str]) -> str:
    return promql_string("|".join(re.escape(value) for value in values))


def duration_seconds(value: str | int) -> int:
    if isinstance(value, int):
        return value

    match = re.fullmatch(r"(\d+)([smhd])", value)
    if not match:
        raise GrafanaError(f"unsupported duration: {value!r}")

    amount = int(match.group(1))
    unit = match.group(2)
    multipliers = {
        "s": 1,
        "m": 60,
        "h": 3600,
        "d": 86400,
    }
    return amount * multipliers[unit]


def integer_at_least_threshold(value: object) -> int:
    """Translate a non-negative integer `>= value` into strict `gt` semantics."""

    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        raise GrafanaError("usage threshold must be a non-negative integer")
    return value - 1


def query_data(ref_id: str, datasource_uid: str, expression: str) -> dict[str, Any]:
    return {
        "refId": ref_id,
        "queryType": "",
        "relativeTimeRange": {"from": 600, "to": 0},
        "datasourceUid": datasource_uid,
        "model": {
            "datasource": {"type": "prometheus", "uid": datasource_uid},
            "editorMode": "code",
            "expr": expression,
            "instant": True,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": False,
            "refId": ref_id,
        },
    }


def threshold_data(evaluator_type: str, threshold: float) -> dict[str, Any]:
    return {
        "refId": "C",
        "queryType": "",
        "relativeTimeRange": {"from": 0, "to": 0},
        "datasourceUid": "__expr__",
        "model": {
            "conditions": [
                {
                    "evaluator": {"params": [threshold], "type": evaluator_type},
                    "operator": {"type": "and"},
                    "query": {"params": ["C"]},
                    "reducer": {"params": [], "type": "last"},
                    "type": "query",
                }
            ],
            "datasource": {"type": "__expr__", "uid": "__expr__"},
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold",
        },
    }


def alert_rule(
    *,
    identity: str,
    uid_registry: dict[str, str],
    title: str,
    folder_uid: str,
    rule_group: str,
    datasource_uid: str,
    expression: str,
    evaluator_type: str,
    threshold: float,
    labels: dict[str, str],
    annotations: dict[str, str],
    contact_point: str,
    duration: str = "5m",
    no_data_state: str = "OK",
    minimum_duration: str = "5m",
    annotation_expression: str | None = None,
) -> dict[str, Any]:
    data = [query_data("A", datasource_uid, expression)]
    if annotation_expression is not None:
        if not isinstance(annotation_expression, str) or not annotation_expression.strip():
            raise GrafanaError("annotation expression must be a non-empty string")
        data.append(query_data("B", datasource_uid, annotation_expression))
    data.append(threshold_data(evaluator_type, threshold))

    return {
        "_identity": identity,
        "uid": rule_uid(identity, uid_registry),
        "title": title,
        "folderUID": folder_uid,
        "ruleGroup": rule_group,
        "condition": "C",
        "data": data,
        "noDataState": no_data_state,
        "execErrState": "Error",
        "for": duration if duration_seconds(duration) >= duration_seconds(minimum_duration) else minimum_duration,
        "annotations": annotations,
        "labels": {**labels, MANAGED_LABEL: MANAGED_VALUE},
        "isPaused": False,
        "notification_settings": {"receiver": contact_point},
    }


def base_labels(config: dict[str, Any], extra: dict[str, str]) -> dict[str, str]:
    labels = {
        "client": config["labels"]["client"],
        "environment": config["labels"]["environment"],
    }
    labels.update(extra)
    return labels


def host_labels(config: dict[str, Any], host: dict[str, Any], check: str) -> dict[str, str]:
    return base_labels(
        config,
        {
            "check": check,
            "host": host["fqdn"],
            "project": host["project"],
            "role": host["role"],
        },
    )


def host_selector(host: str) -> str:
    return f'host="{promql_string(host)}"'


def dependency_state_queries(
    config: dict[str, Any], dependency: str, *, freshness_window: str, settle_window: str,
) -> tuple[str | None, str, int]:
    duration_seconds(freshness_window)
    duration_seconds(settle_window)
    control_hosts = sorted({host["fqdn"] for host in config["hosts"] if host.get("control_node")})
    if not control_hosts:
        return None, "vector(0)", 1

    selector = (
        "node_systemd_unit_state{"
        f'host=~"{domain_regex(control_hosts)}",'
        f'name="{promql_string(dependency)}",state=~"active|activating"}}'
    )
    # Both state series must be fresh before a previous active sample can suppress CPU.
    fresh = f"(count by (host) (count by (host, state) (last_over_time({selector}[{freshness_window}]))) == 2)"
    reporting = f"(count({fresh}) or vector(0))"
    # The configured settling window includes the scrape interval.
    recent = f"(max by (host) (max_over_time({selector}[{settle_window}])) > 0)"
    suppress = (
        f"(max({recent} and on (host) {fresh}) "
        f"and on () ({reporting} == {len(control_hosts)}))"
    )
    return suppress, reporting, len(control_hosts)














def first_matching(
    items: list[dict[str, Any]],
    required: dict[str, Any],
    defaults: dict[str, Any] | None = None,
) -> dict[str, Any] | None:
    """Select the first matching item without assuming any deployed role or service."""
    defaults = defaults or {}
    return next(
        (item for item in items if all(item.get(key, defaults.get(key)) == value for key, value in required.items())),
        None,
    )


def render_rule_templates(
    config: dict[str, Any], folder_uid: str, datasource_uid: str,
    definitions: dict[str, Any],
) -> list[dict[str, Any]]:
    """Render operator-supplied definitions with a restricted, credential-free context."""
    if not isinstance(definitions, dict) or not isinstance(definitions.get("templates"), list):
        raise GrafanaError("Alert definitions must provide a template list")
    parameters = definitions.get("parameters", {})
    if not isinstance(parameters, dict):
        raise GrafanaError("Alert parameters must be a mapping")
    context_config = {
        key: config[key]
        for key in ("labels", "thresholds", "hosts", "sites", "public_status", "service_units", "tls_mode", "uid_registry", "process_containers")
        if key in config
    }
    context_config["grafana"] = {
        key: config.get("grafana", {})[key]
        for key in ("folder", "evaluation_group", "evaluation_interval", "contact_point", "prometheus_datasource_name")
        if key in config.get("grafana", {})
    }
    renderer = SandboxedEnvironment(
        undefined=StrictUndefined, extensions=["jinja2.ext.do", "jinja2.ext.loopcontrols"],
        autoescape=False,
    )
    renderer.globals.clear()
    renderer.globals.update(
        alert_rule=alert_rule, base_labels=base_labels,
        dependency_state_queries=lambda data, unit: dependency_state_queries(
            data, unit, freshness_window=parameters["dependency_freshness"],
            settle_window=parameters["dependency_settle"],
        ), domain_regex=domain_regex,
        domain_rule_identity=domain_rule_identity, duration_seconds=duration_seconds,
        host_labels=host_labels, host_rule_identity=host_rule_identity,
        host_selector=host_selector, integer_at_least_threshold=integer_at_least_threshold,
        promql_string=promql_string, service_rule_identity=service_rule_identity,
        first_matching=first_matching, float=float, list=list, repr=repr,
        format_value=format,
    )
    output = []
    for definition in definitions["templates"]:
        if not isinstance(definition, dict) or not isinstance(definition.get("template"), str):
            raise GrafanaError("Each alert definition must provide a template")
        try:
            rendered = renderer.from_string(definition["template"]).render(
                config=copy.deepcopy(context_config), parameters=copy.deepcopy(parameters),
                folder_uid=folder_uid, datasource_uid=datasource_uid,
            )
            rules = json.loads(rendered)
        except (TemplateError, ValueError, TypeError, KeyError, GrafanaError):
            raise GrafanaError("Alert definition rendering failed") from None
        if isinstance(rules, dict):
            rules = [rules]
        if not isinstance(rules, list) or any(not isinstance(rule, dict) for rule in rules):
            raise GrafanaError("Alert templates must produce rule objects")
        for rule in rules:
            if (
                any(not isinstance(rule.get(key), str) or not rule[key] for key in ("_identity", "uid", "title"))
                or not valid_rule_uid(rule["uid"])
                or not isinstance(rule.get("data"), list)
                or not isinstance(rule.get("labels"), dict)
                or not isinstance(rule.get("annotations"), dict)
            ):
                raise GrafanaError("Alert template produced an invalid rule")
        output.extend(rules)
    return output


def decode_rule_definitions(encoded: str) -> dict[str, Any]:
    """Decode definitions without allowing configuration text into diagnostics."""
    try:
        data = yaml.safe_load(base64.b64decode(encoded, validate=True))
    except (ValueError, TypeError, yaml.YAMLError):
        raise GrafanaError("Alert definitions could not be decoded") from None
    if not isinstance(data, dict):
        raise GrafanaError("Alert definitions must be a mapping")
    return data


def desired_rules(config: dict[str, Any], folder_uid: str, datasource_uid: str) -> dict[str, dict[str, Any]]:
    rules = render_rule_templates(config, folder_uid, datasource_uid, config["rule_definitions"])
    identities = [rule.pop("_identity") for rule in rules]
    if len(set(identities)) != len(identities):
        raise GrafanaError("generated Grafana alert identities are not unique")
    if len({rule["uid"] for rule in rules}) != len(rules):
        raise GrafanaError("generated Grafana alert UIDs are not unique")
    return {rule["uid"]: rule for rule in rules}


def comparable(rule: dict[str, Any]) -> dict[str, Any]:
    keys = [
        "uid",
        "title",
        "folderUID",
        "ruleGroup",
        "condition",
        "data",
        "noDataState",
        "execErrState",
        "for",
        "annotations",
        "labels",
        "isPaused",
        "notification_settings",
    ]
    return {key: rule.get(key) for key in keys}


def is_managed(rule: dict[str, Any], client: str) -> bool:
    labels = rule.get("labels", {})
    return labels.get(MANAGED_LABEL) == MANAGED_VALUE and labels.get("client") == client


def timestamp(value: datetime) -> str:
    return value.isoformat(timespec="milliseconds").replace("+00:00", "Z")


def create_initial_silence(config: dict[str, Any], duration_minutes: int) -> str:
    if duration_minutes < 1:
        raise GrafanaError("initial silence duration must be at least one minute")

    client = GrafanaClient(config["grafana"]["stack_url"], config["grafana"]["api_token"])
    labels = config["labels"]
    now = datetime.now(timezone.utc)
    payload = {
        "matchers": [
            {
                "name": MANAGED_LABEL,
                "value": MANAGED_VALUE,
                "isRegex": False,
                "isEqual": True,
            },
            {
                "name": "client",
                "value": labels["client"],
                "isRegex": False,
                "isEqual": True,
            },
            {
                "name": "environment",
                "value": labels["environment"],
                "isRegex": False,
                "isEqual": True,
            },
        ],
        "startsAt": timestamp(now),
        "endsAt": timestamp(now + timedelta(minutes=duration_minutes)),
        "createdBy": INITIAL_SILENCE_CREATED_BY,
        "comment": INITIAL_SILENCE_COMMENT,
    }
    return client.create_silence(payload)


def sync(config: dict[str, Any]) -> tuple[int, int, int]:
    client = GrafanaClient(config["grafana"]["stack_url"], config["grafana"]["api_token"])
    datasource_uid = client.datasource_uid(config["grafana"]["prometheus_datasource_name"])
    folder_uid = client.folder_uid(config["grafana"]["folder"])
    desired = desired_rules(config, folder_uid, datasource_uid)
    existing = {
        rule["uid"]: rule
        for rule in client.alert_rules()
        if is_managed(rule, config["labels"]["client"])
    }

    created = 0
    updated = 0
    deleted = 0

    for uid, rule in desired.items():
        if uid not in existing:
            client.create_rule(rule)
            created += 1
            continue

        if comparable(existing[uid]) != comparable(rule):
            client.update_rule(uid, rule)
            updated += 1

    for uid in sorted(set(existing) - set(desired)):
        client.delete_rule(uid)
        deleted += 1

    if desired:
        interval_seconds = duration_seconds(config["grafana"]["evaluation_interval"])
        if client.update_rule_group_interval(folder_uid, config["grafana"]["evaluation_group"], interval_seconds):
            updated += 1

    return created, updated, deleted


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", required=True, help="Path to Grafana alert sync JSON configuration")
    parser.add_argument(
        "--create-initial-silence",
        action="store_true",
        help="Create the initial convergence silence and exit without syncing alert rules",
    )
    parser.add_argument(
        "--silence-minutes",
        type=int,
        default=15,
        help="Initial convergence silence duration in minutes",
    )
    args = parser.parse_args()

    with open(args.config, encoding="utf-8") as config_file:
        config = json.load(config_file)

    if args.create_initial_silence:
        silence_id = create_initial_silence(config, args.silence_minutes)
        print(f"changed=true silence_id={silence_id}")
        return 0

    config["uid_registry"] = load_uid_registry(config["uid_registry_file"])
    config["rule_definitions"] = decode_rule_definitions(config["rule_definitions_base64"])
    created, updated, deleted = sync(config)
    changed = created + updated + deleted > 0
    print(f"changed={str(changed).lower()} created={created} updated={updated} deleted={deleted}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except GrafanaError as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
