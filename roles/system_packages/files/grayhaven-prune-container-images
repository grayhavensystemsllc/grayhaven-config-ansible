#!/usr/bin/env python3
"""Remove unused repository images after verifying the deployed container."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys


class ImageCleanupError(RuntimeError):
    """Container state could not be verified for image cleanup."""


def command(arguments: list[str]) -> str:
    return subprocess.run(
        ["podman", *arguments], capture_output=True, text=True,
        check=True, timeout=120,
    ).stdout


def records(arguments: list[str]) -> list[dict]:
    value = json.loads(command(arguments))
    if not isinstance(value, list) or not all(isinstance(row, dict) for row in value):
        raise ImageCleanupError("Unsupported container metadata")
    return value


def image_id(value: str) -> str:
    if not isinstance(value, str):
        raise ImageCleanupError("Unsupported image identity")
    value = value.removeprefix("sha256:")
    if not re.fullmatch(r"[0-9a-f]{64}", value):
        raise ImageCleanupError("Unsupported image identity")
    return value


def repository(reference: str) -> str:
    value = reference.split("@", 1)[0]
    if value.rfind(":") > value.rfind("/"):
        value = value.rsplit(":", 1)[0]
    return value


def deployed(container: str, digest: str) -> dict:
    result = records(["container", "inspect", container])
    if len(result) != 1:
        raise ImageCleanupError("Deployed container is unavailable")
    current = result[0]
    state = current.get("State", {})
    if (not state.get("Running") or state.get("Health", {}).get("Status") != "healthy"
            or current.get("ImageDigest") != digest):
        raise ImageCleanupError("The approved container is not healthy")
    image_id(current["Id"])
    image_id(current["Image"])
    return current


def referenced_images() -> set[str]:
    return {image_id(row["ImageID"]) for row in records(["ps", "--all", "--format", "json"])}


def cleanup(container: str, image: str, *, dry_run: bool = False) -> dict[str, int]:
    match = re.fullmatch(r"([A-Za-z0-9][A-Za-z0-9._:/-]*)@(sha256:[0-9a-f]{64})", image)
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", container) or not match:
        raise ImageCleanupError("A container and immutable image are required")
    reference, digest = match.groups()
    expected = repository(reference)
    current = deployed(container, digest)
    used = referenced_images() | {image_id(current["Image"])}
    candidates = set()
    for row in records(["images", "--format", "json"]):
        identity = image_id(row.get("Id", row.get("ID")))
        names = row["Names"]
        if names is None:
            continue
        if not isinstance(names, list) or not all(isinstance(name, str) for name in names):
            raise ImageCleanupError("Unsupported image references")
        if (identity not in used and names
                and all(repository(name) == expected for name in names)):
            candidates.add(identity)
    removed = 0
    if not dry_run:
        for identity in sorted(candidates):
            if deployed(container, digest)["Id"] != current["Id"]:
                raise ImageCleanupError("The deployed container changed during cleanup")
            if identity in referenced_images():
                continue
            # Podman refuses removal if a container acquired the image meanwhile.
            command(["image", "rm", "--no-prune", identity])
            removed += 1
    return {"removed": removed, "eligible": len(candidates)}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("container")
    parser.add_argument("image")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)
    try:
        result = cleanup(args.container, args.image, dry_run=args.dry_run)
    except Exception:
        print("Container image cleanup failed; retained images require verification.", file=sys.stderr)
        return 1
    print(json.dumps(result))
    return 0


if __name__ == "__main__":  # pragma: no cover - command-line entrypoint
    raise SystemExit(main())
