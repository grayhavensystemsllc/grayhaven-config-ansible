#!/usr/bin/env python3
"""Validate generated Grafana alerts using fictional inputs."""

from __future__ import annotations

import argparse
import hashlib
import json
import pathlib
import runpy


REPO_ROOT = pathlib.Path(__file__).resolve().parents[1]
ALERT_SYNC = REPO_ROOT / "roles" / "observability" / "files" / "grayhaven-grafana-alert-sync"
UID_REGISTRY = REPO_ROOT / "roles" / "observability" / "files" / "grafana-alert-rule-uids.json"


class FixtureRegistry(dict):
    """Supply deterministic fictional identities without a production registry."""

    def __missing__(self, identity: str) -> str:
        uid = "gh-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()[:24]
        self[identity] = uid
        return uid


def fixture_config() -> dict[str, object]:
    return {
        "uid_registry": FixtureRegistry(),
        "uid_registry_file": "/fixture/registry.json",
        "grafana": {
            "contact_point": "fixture-contact",
            "evaluation_group": "fixture-group",
        },
        "hosts": [
            {
                "client": "fixture",
                "control_node": False,
                "environment": "test",
                "fqdn": "worker.example.invalid",
                "project": "fixture",
                "role": "web",
                "short_hostname": "worker",
            }
        ],
        "labels": {"client": "fixture", "environment": "test"},
        "service_units": {
            "common": [],
            "control_node": [],
            "web": [{
                "check": "fixture_service",
                "name": "mock-dependency.service",
                "summary": "Fixture service is down",
            }],
        },
        "sites": [{
            "aliases": [],
            "dev_domain": "",
            "domain": "application.example.invalid",
            "kind": "application",
            "root_name": "fixture-application",
            "display_name": "Fixture Application",
            "health_check": "fixture_health",
        }],
        "thresholds": {
            "certificate_expiring_seconds": 123_456,
            "cpu_percent": 73,
            "filesystem_inode_percent": 74,
            "filesystem_percent": 75,
            "gcs_class_a_monthly_warning_operations": 1_234,
            "gcs_class_b_monthly_warning_operations": 2_345,
            "gcs_operation_stale_seconds": 1_801,
            "gcs_stale_bucket_check_stale_seconds": 2_802,
            "google_monitoring_monthly_warning_series": 3_456,
            "google_monitoring_usage_stale_seconds": 1_803,
            "memory_percent": 76,
            "restic_stale_seconds": 4_321,
            "swap_percent": 77,
        },
        "tls_mode": "host",
    }


def imported_identity(rule: dict[str, object]) -> str:
    labels = rule["labels"]
    check = labels["check"]
    for scope in ("host", "domain", "service"):
        if scope in labels:
            return f"{scope}:{labels[scope]}:{check}"
    return f"check:{check}"


def validate_live_registry(
    namespace: dict[str, object],
    registry: dict[str, str],
    live_rules: list[dict[str, object]],
    desired_rules: list[dict[str, object]] | None = None,
) -> None:
    managed = [
        rule for rule in live_rules
        if rule.get("labels", {}).get("configured_by") == "ansible"
    ]
    if len(managed) != len(registry):
        raise RuntimeError("Managed-rule count does not match the registry")
    imported = {imported_identity(rule): rule["uid"] for rule in managed}
    if len(imported) != len(managed) or imported != registry:
        raise RuntimeError("Managed-rule identities do not match the registry")
    if not all(namespace["valid_rule_uid"](uid) for uid in registry.values()):
        raise RuntimeError("Registry contains an invalid UID")
    if len(set(registry.values())) != len(registry):
        raise RuntimeError("Registry UIDs are not unique")
    if desired_rules is not None:
        desired = {rule["uid"]: rule for rule in desired_rules}
        for rule in managed:
            expected = desired.get(rule["uid"])
            if expected is not None and namespace["comparable"](rule) != namespace["comparable"](expected):
                raise RuntimeError("Managed rule differs from its expected definition")


def validate_generated_rules(
    namespace: dict[str, object], rules: dict[str, dict[str, object]]
) -> None:
    if not rules:
        raise RuntimeError("No alert rules were generated")
    for uid, rule in rules.items():
        if uid != rule["uid"] or not namespace["valid_rule_uid"](uid):
            raise RuntimeError("Generated alert rule has an invalid UID")
        if namespace["duration_seconds"](rule["for"]) < 300:
            raise RuntimeError("Generated alert rule has an invalid pending period")
        queries = rule["data"]
        if not queries or not queries[0]["model"]["expr"]:
            raise RuntimeError("Generated alert rule has no query")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--live-export",
        type=pathlib.Path,
        help="Validate the committed UID registry against a Grafana provisioning export",
    )
    args = parser.parse_args(argv)
    namespace = runpy.run_path(str(ALERT_SYNC))
    config = fixture_config()
    rules = namespace["desired_rules"](config, "fixture-folder", "fixture-datasource")
    validate_generated_rules(namespace, rules)
    if args.live_export:
        registry = namespace["load_uid_registry"](str(UID_REGISTRY))
        live_rules = json.loads(args.live_export.read_text(encoding="utf-8"))
        validate_live_registry(namespace, registry, live_rules)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
