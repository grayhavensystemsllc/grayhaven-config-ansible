#!/usr/bin/env python3
"""Render and validate the Grafana Alloy template with synthetic values."""

from __future__ import annotations

import argparse
import json
import pathlib
import re
import subprocess
import sys
import tempfile

import jinja2


REPO_ROOT = pathlib.Path(__file__).resolve().parents[1]
TEMPLATE_DIR = REPO_ROOT / "roles" / "observability" / "templates"
TEMPLATE_NAME = "config.alloy.j2"


def regex_replace(value: object, pattern: str, replacement: str) -> str:
    return re.sub(pattern, replacement, str(value))


def build_environment() -> jinja2.Environment:
    environment = jinja2.Environment(
        loader=jinja2.FileSystemLoader(TEMPLATE_DIR),
        autoescape=False,
        keep_trailing_newline=True,
    )
    environment.filters["regex_replace"] = regex_replace
    environment.filters["string"] = str
    environment.filters["to_json"] = json.dumps
    return environment


def fixture_context(role: str = "web") -> dict[str, object]:
    context = {
        "grayhaven_role": "web",
        "inventory_hostname": "worker.example.invalid",
        "baseline_validation_environment": "test",
        "observability_alloy_token_file": "/fixture/token",
        "observability_client": "fixture",
        "observability_grafana_credentials": {
            "loki": {
                "push_url": "https://logs.example.invalid/loki/api/v1/push",
                "username": "654321",
            },
            "prometheus": {
                "remote_write_url": "https://prometheus.example.invalid/api/prom/push",
                "username": "123456",
            },
        },
        "observability_logs_enabled": True,
        "observability_project": "fixture",
        "observability_role": "web",
        "observability_short_hostname": "worker",
        "observability_textfile_dir": "/fixture/textfile",
        "observability_web_sites": [
            {
                "aliases": ["www.business.example.invalid"],
                "dev_domain": "dev.business.example.invalid",
                "domain": "business.example.invalid",
                "kind": "website",
                "nginx_log_names": [
                    "prod.access",
                    "prod.error",
                    "dev.access",
                    "dev.error",
                ],
                "root_name": "business.example.invalid",
            },
            {
                "aliases": ["www.personal.example.invalid"],
                "dev_domain": "dev.personal.example.invalid",
                "domain": "personal.example.invalid",
                "kind": "website",
                "nginx_log_names": [
                    "prod.access",
                    "prod.error",
                    "dev.access",
                    "dev.error",
                ],
                "root_name": "personal.example.invalid",
            },
            {
                "aliases": [],
                "dev_domain": "",
                "domain": "app.example.invalid",
                "kind": "application",
                "nginx_log_names": ["access", "error"],
                "root_name": "fixture-app",
                "health_url": "http://127.0.0.1:3417/ready",
                "health_check": "fixture_health",
            },
        ],
    }

    if role == "mcp":
        context.update(grayhaven_role="mcp", observability_role="mcp", inventory_hostname="service.example.invalid",
                       observability_short_hostname="service")
        context["observability_web_sites"].append({
            "root_name":"fixture-service", "kind":"application", "role":"mcp", "domain":"service.example.invalid",
            "aliases":[], "dev_domain":"", "nginx_log_names":["access", "error"], "redirect_http":False,
            "health_url":"http://127.0.0.1:3418/ready", "health_check":"fixture_service_health",
        })
    return context


def render_config(output_path: pathlib.Path, role: str = "web") -> None:
    template = build_environment().get_template(TEMPLATE_NAME)
    output_path.write_text(template.render(fixture_context(role)), encoding="utf-8")


def validate_application_contract(rendered_path: pathlib.Path, site: dict[str, object]) -> None:
    rendered = rendered_path.read_text(encoding="utf-8")
    site_id = regex_replace(site["root_name"], r"[^A-Za-z0-9_]", "_")
    required = (
        f'{site_id}_health:',
        f'Host: "{site["domain"]}"',
        f'address = "{site["health_url"]}"',
        f'module  = "{site_id}_health"',
        f'check       = "{site["health_check"]}"',
    )
    missing = [value for value in required if value not in rendered]
    if missing:
        raise RuntimeError(f"Rendered Alloy application contract is missing: {missing}")


def validate_https_probe_contract(rendered_path: pathlib.Path) -> None:
    """Ensure shared HTTPS probes complete TLS independently of HTTP status."""

    rendered = rendered_path.read_text(encoding="utf-8")
    for module in ("https_any_status_skip_tls_verify", "https_any_status_trusted"):
        match = re.search(
            rf"^  {re.escape(module)}:\n(?P<body>.*?)(?=^  [A-Za-z0-9_]+:\n|^`$)",
            rendered,
            flags=re.MULTILINE | re.DOTALL,
        )
        if match is None:
            raise RuntimeError(f"Rendered Alloy HTTPS probe module is missing: {module}")
        status_codes = {
            int(value)
            for value in re.findall(r"^        - (\d+)$", match.group("body"), re.MULTILINE)
        }
        if status_codes != set(range(100, 600)):
            raise RuntimeError(
                f"Rendered Alloy {module} module does not accept every HTTP status"
            )

    skip_verify_count = rendered.count('module  = "https_any_status_skip_tls_verify"')
    trusted_count = rendered.count('module  = "https_any_status_trusted"')
    if skip_verify_count == 0 or trusted_count == 0:
        raise RuntimeError("Rendered Alloy HTTPS targets do not use shared TLS probes")
    if "http_2xx_skip_tls_verify" in rendered or 'module  = "http_2xx"' in rendered:
        raise RuntimeError("Rendered Alloy retained a status-limited HTTPS probe")

    for target in re.findall(r"^  target \{\n(?P<body>.*?^  \})", rendered, re.MULTILINE | re.DOTALL):
        check_match = re.search(r'^      check\s+=\s+"([^"]+)",?$', target, re.MULTILINE)
        if check_match is None or check_match.group(1) not in {
            "https_200",
            "ssl_certificate",
            "ssl_certificate_trusted",
        }:
            continue
        module = re.search(r'^    module\s+=\s+"([^"]+)"$', target, re.MULTILINE)
        address = re.search(r'^    address\s+=\s+"https://([^/]+)/"$', target, re.MULTILINE)
        domain = re.search(r'^      domain\s+=\s+"([^"]+)",?$', target, re.MULTILINE)
        if module is None or address is None or domain is None or address.group(1) != domain.group(1):
            raise RuntimeError(
                f"Rendered Alloy {check_match.group(1)} target does not preserve its requested hostname"
            )
        expected_module = (
            "https_any_status_trusted"
            if check_match.group(1) == "ssl_certificate_trusted"
            else "https_any_status_skip_tls_verify"
        )
        if module.group(1) != expected_module:
            raise RuntimeError(
                f"Rendered Alloy {check_match.group(1)} target uses the wrong TLS probe module"
            )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--role", choices=("web", "mcp"), default="web")
    parser.add_argument(
        "--keep-rendered",
        metavar="PATH",
        help="write the rendered Alloy file to PATH instead of a temporary file",
    )
    args = parser.parse_args()

    with tempfile.TemporaryDirectory(prefix="grayhaven-alloy.") as temp_dir:
        rendered_path = pathlib.Path(args.keep_rendered or pathlib.Path(temp_dir) / "config.alloy")
        rendered_path.parent.mkdir(parents=True, exist_ok=True)
        render_config(rendered_path, args.role)
        if args.role == "web":
            site = next(site for site in fixture_context()["observability_web_sites"] if site["kind"] == "application")
            validate_application_contract(rendered_path, site)
        validate_https_probe_contract(rendered_path)
        try:
            result = subprocess.run(["alloy", "validate", str(rendered_path)], check=False)
        except FileNotFoundError:
            print("alloy is required to validate rendered Alloy configuration", file=sys.stderr)
            return 127
        return result.returncode


if __name__ == "__main__":
    sys.exit(main())
